{
  "name": "ghostcursor",
  "version": "0.2.2",
  "private": true,
  "description": "Windows 窗口共享与访客鼠标协作",
  "author": "GhostCursor",
  "license": "UNLICENSED",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "start:app": "electron .",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "build": {
    "appId": "app.ghostcursor.desktop",
    "productName": "GhostCursor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/web/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "extraResources": [
      {
        "from": "dist/native",
        "to": "native"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  }
}
